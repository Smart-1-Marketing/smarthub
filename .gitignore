# Runtime data written by the app — never belongs in the repo
data/
modules/*/data/
# ...but hub/data holds source data that ships with the code, not runtime
# output. Without this the rate card JSON is silently never committed and the
# rate card is simply empty in production, with nothing to say why.
!hub/data/
!hub/data/**
# ...but hub/data holds source data that ships with the code, not runtime
# output. Without this the rate card JSON is silently never committed and the
# rate card is simply empty in production, with nothing to say why.
!hub/data/
!hub/data/**
_attic/

# Private client and billing exports. Production reads Knack directly and may
# use CLIENTS_DATA_DIR as a private mounted fallback; raw exports never belong
# in Git.
!clients_app/data/
clients_app/data/*.json
!clients_app/data/README.md
modules/sites_admin/Portfolio.json
modules/sites_admin/portfolio.json

# SQLite. image_picker.db reached the repo root because models.py opens it
# on a relative path, so it lands in whatever the process CWD happens to be.
*.db
*.sqlite3
*.db-journal

# Scheduler singleton guard
hub-scheduler.lock

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local env
.env

# Generated landing-page reports — runtime output, not source. One of these
# reached the repo from a local test run; the directory is recreated on demand.
modules/*/static/reports/

# Preview dumps from test runs — runtime output, not source.
# test_youtube_ads.py writes tmp/youtube-ads-preview.html so the rendered page
# can be eyeballed; it mkdirs the directory on demand, so running the suite
# dirtied the tree and invited exactly the stray-file commit the entry above
# records happening once already.
tmp/
