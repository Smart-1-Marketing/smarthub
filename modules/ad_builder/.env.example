# Cloudinary — required for --upload and for the gallery to search live
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Root folder all Smart 1 work lives under
CLOUDINARY_ROOT_FOLDER=smart1-ads

# 'fixed'   = folder is a prefix of the public_id, search with folder:
# 'dynamic' = asset_folder is independent, search with asset_folder:
# Check which mode your account uses before first upload.
CLOUDINARY_FOLDER_MODE=fixed

# Brandfetch — brand discovery from a domain
BRANDFETCH_API_KEY=
# Set to 1 to use src/examples/brandfetch-sample.json instead of the API
BRANDFETCH_MOCK=

# Origins allowed to iframe /embed. Without this, only same-origin framing works.
ALLOWED_FRAME_ANCESTORS='self' https://smart1marketing.com https://www.smart1marketing.com
# Origins allowed to call the API cross-origin (not needed for iframe embedding)
ALLOWED_ORIGINS=

# OpenAI — landing page reading and (later) copy generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Required. Protects the build screen, diagnostics and all campaign data.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Local file retention, in days. Cloudinary holds the permanent copies.
RENDER_RETENTION_DAYS=30
CACHE_RETENTION_DAYS=7

# Notifications — set either or both. Without one, messages are appended to
# out/notifications/outbox.jsonl instead of being lost.
RESEND_API_KEY=
EMAIL_FROM=Smart 1 Ad Builder <onboarding@resend.dev>
EMAIL_TO=
NOTIFY_WEBHOOK_URL=

# Public URL of this service, used to build links inside notifications.
PUBLIC_URL=https://adbuilder.onrender.com

# Hours between self-checks that alert (via notifications) when diagnostics
# transitions to broken. 0 disables.
HEALTH_CHECK_HOURS=3

# Team access code for the intake form. When set, the form asks for this code
# before it opens, and every intake API call requires it. Deliberately separate
# from ADMIN_TOKEN: the code is shared around the office and unlocks only the
# ability to submit requests, never the build screen or project data.
# Leave unset for an open public form.
INTAKE_CODE=

# Minutes a render job may run before the watchdog kills it, fails it loudly,
# and notifies staff. 0 disables. Rendering competes with the web server for
# CPU, so an underpowered instance shows up here first.
RENDER_WATCHDOG_MIN=10

# libvips thread pool size. Defaults to 2 because Render containers report the
# HOST's core count, and a small instance thrashes at 8 threads. Raise this on
# instances with 2+ dedicated CPUs.
SHARP_CONCURRENCY=2
