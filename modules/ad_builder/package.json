{
  "name": "smart1-ad-builder",
  "version": "0.1.0",
  "description": "",
  "main": "dist/src/server.js",
  "scripts": {
    "assets": "tsx scripts/make-sample-assets.ts",
    "render:google": "tsx src/cli.ts --platform google",
    "render:amazon": "tsx src/cli.ts --platform amazon",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "render:google:upload": "tsx src/cli.ts --platform google --upload",
    "render:amazon:upload": "tsx src/cli.ts --platform amazon --upload",
    "gallery": "tsx src/gallery.ts",
    "scaffold": "tsx scripts/scaffold.ts",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "diagnose": "tsx -e \"import('./src/diagnostics').then(async m=>{const r=await m.runDiagnostics({outDir:process.env.OUTPUT_DIR||'out',assetRoot:process.cwd()});console.log(JSON.stringify(r.summary),r.verdict);for(const c of r.checks)if(c.level!=='ok')console.log(c.level.toUpperCase(),c.label,'-',c.detail)})\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@types/pdfkit": "^0.17.6",
    "cloudinary": "^2.10.0",
    "opentype.js": "^2.0.0",
    "pdfkit": "^0.19.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
