{
  "name": "smart1-ad-builder",
  "version": "0.1.0",
  "description": "",
  "main": "dist/src/server.js",
  "scripts": {
    "assets": "tsx scripts/make-sample-assets.ts",
    "render:google": "tsx src/cli.ts --platform google",
    "render:amazon": "tsx src/cli.ts --platform amazon",
    "prebuild": "node scripts/build-fonts-manifest.mjs",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "render:google:upload": "tsx src/cli.ts --platform google --upload",
    "render:amazon:upload": "tsx src/cli.ts --platform amazon --upload",
    "gallery": "tsx src/gallery.ts",
    "scaffold": "tsx scripts/scaffold.ts",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/worker.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "diagnose": "tsx -e \"import('./src/diagnostics').then(async m=>{const r=await m.runDiagnostics({outDir:process.env.OUTPUT_DIR||'out',assetRoot:process.cwd()});console.log(JSON.stringify(r.summary),r.verdict);for(const c of r.checks)if(c.level!=='ok')console.log(c.level.toUpperCase(),c.label,'-',c.detail)})\"",
    "test:browser": "tsx --test tests-browser/*.e2e.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/abril-fatface": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/cabin": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/dosis": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/fira-sans": "^5.3.0",
    "@fontsource/fjalla-one": "^5.3.0",
    "@fontsource/hind": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/kanit": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/oxygen": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0",
    "@fontsource/quicksand": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/righteous": "^5.3.0",
    "@fontsource/titillium-web": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@types/pdfkit": "^0.17.6",
    "cloudinary": "^2.11.0",
    "opentype.js": "^2.0.0",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/opentype.js": "^1.3.10",
    "puppeteer-core": "^25.11.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
