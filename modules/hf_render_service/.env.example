# hf-render-service reads no credentials at all — it is self-hosted, and
# there is nothing to authenticate to a vendor. These three are the whole
# of its configuration surface, and every one has a sane default.

# Loopback only. docker-start.sh sets both when it starts this alongside
# the Hub; set HOST=0.0.0.0 only if you are deliberately running this as
# its own standalone Render service (see render.yaml) rather than as a
# second process in the Hub's own container.
PORT=8792
HOST=127.0.0.1

# Where finished renders (and their working frame directories) are written.
# Defaults to ./out when unset. docker-start.sh points this at the shared
# persistent disk the same way it does for OUTPUT_DIR/adbuilder-out.
HF_OUTPUT_DIR=

# How many renders may run at once. A render pins a CPU core for the
# duration of the capture; on a 2-CPU container, 1 is the safe default so
# a render never starves the Hub's own request-serving workers. Raise this
# only once you have watched the Hub stay responsive during a real render.
HF_RENDER_CONCURRENCY=1
