# ================= Smart 1 Hub =================
# One login for every module.
# The shared emergency password. It creates no account, so nothing it does is
# attributable — and hub/access.py treats it as Admin, because it is how you
# reach Diagnostics when sign-in itself is what is broken. Clear it once every
# real account exists and that door closes for good.
PANEL_PASSWORD=change-me-to-something-strong
# Signs the hub login cookie AND the Sites admin session. Keep it stable so
# logins survive restarts. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# The public URL of this service, used wherever a link has to work from
# OUTSIDE the Hub. Two things break silently while it is blank:
#   - Site Scans: Insites never posts a finished audit back to
#     /scans/api/callback, so every scan hangs on "running" forever.
#   - Landing Page Maker: a built page carries a relative lead-capture URL,
#     so once the page is pasted into Smart 1 Sites, a GHL funnel or the
#     client's own CMS its form posts to THEIR domain and 404s. The page
#     looks perfect and takes no leads. The maker says so when it builds a
#     page without this set.
# No trailing slash.
PUBLIC_BASE_URL=

# ================= Suite (GoHighLevel) =================
GHL_PRIVATE_TOKEN=pit-...
GHL_COMPANY_ID=
GHL_API_VERSION=2021-07-28
# Proposal opportunities are filed into the Smart 1 Marketing sub-account named
# by GHL_LEAD_LOCATION_ID (see the Leads section below) -- one location
# setting, not one per feature. It is the sub-account id, NOT the agency
# company id; hub/ghl_contacts.py refuses the two being the same, because a
# companyId used as a locationId files everything against the agency where
# nobody goes looking.
#
# Optional. Left blank, the pipeline and its "proposal sent" stage are found
# through the API, which is right for a single-pipeline account.
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
# Marketplace app — needed for anything owned by a sub-account (Forms above
# all): the agency token above cannot read those, whatever scopes it has.
# Install once at the agency, then the Hub issues per-client tokens itself.
# Redirect URL to register on the app: <PUBLIC_BASE_URL>/suite/oauth/callback
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# Optional — overrides the default read-only scope set
GHL_OAUTH_SCOPES=
# Who may frame a Hub page inside their own UI. CSP frame-ancestors syntax,
# space-separated. An allowlist, never a wildcard: a staff tool with
# destructive buttons behind the login is a clickjacking target. Defaults to
# HighLevel's own hosts plus smart1marketing.com -- set this if the agency
# runs on a whitelabel domain.
HUB_EMBED_FRAME_ANCESTORS=
# Optional — enables "Auto-fill from client website"
BRANDFETCH_API_KEY=

# ================= Sites (Simvoly) =================
SIMVOLY_API_KEY=
SIMVOLY_API_BASE_URL=https://api.smart1sites.com
# Render Postgres Internal Database URL
DATABASE_URL=
MOCK_MODE=false
ENABLE_WRITE_ACTIONS=false

# ================= Google Finder =================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FLASK_SECRET_KEY=
ALLOWED_EMAILS=adops@smart1marketing.com,smartadops@gmail.com,smart1sites@gmail.com
CACHE_SECONDS=900
TOKEN_DB_PATH=/var/data/google_tokens.db
# Generate once, never change: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ================= Smart 1 Ads (/tools/ads) =================
# Google Ads campaign operations. Deliberately GOOGLE_ADS_* rather than
# GOOGLE_*, so this module and the Google Finder can never fight over one
# OAuth client; with GOOGLE_ADS_CLIENT_ID blank it falls back to the two
# above. Blank credentials are not a broken tool -- /tools/ads/settings names
# every variable it is missing and the rest of the module stays readable.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Google Ads MANAGER account > Tools > API Center. This is the one with lead
# time on it: Google approves the token, it is not self-issued.
GOOGLE_ADS_DEVELOPER_TOKEN=
# The MCC id, digits only, no dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Must match the Authorised redirect URI in Google Cloud Console character for
# character. Render stores quotes literally, so do not quote it.
GOOGLE_ADS_REDIRECT_URI=https://smart1-hub.onrender.com/tools/ads/oauth/callback
# Shown once after Connect Google Ads. Pasted back here it survives a database
# reset; left blank the token lives in the hub database only.
GOOGLE_ADS_REFRESH_TOKEN=
# Optional. v21-v25 are documented as of Aug 2026; v25 is the default.
GOOGLE_ADS_API_VERSION=v25

# ================= Proposals (Cloudinary) =================
# Stores generated proposal PDFs AND the proposals you upload in Client 360.
# Copy the "API Environment variable" from the Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_FOLDER=smart1-proposals
MAX_PROPOSAL_MB=25

# ================= SEO Image Pipeline (/tools/seo-images) =================
# Uses CLOUDINARY_URL above. If you'd rather set the three parts separately
# (the way the standalone prototype did), these work too — either is enough.
#CLOUDINARY_CLOUD_NAME=
#CLOUDINARY_API_KEY=
#CLOUDINARY_API_SECRET=
SEO_IMAGES_FOLDER=smart1-seo-images
# Vision model that writes the filenames and alt text — must accept images.
OPENAI_VISION_MODEL=gpt-4o
# Default cap on an image's longest edge, applied BEFORE the WebP conversion.
# This is what actually takes the weight off a camera photo; WebP alone does
# not resize. Staff can override per batch. 0 = keep original size.
SEO_IMAGES_MAX_EDGE=2400

# ================= Image Creator (/tools/image-creator) =================
# Universal stock search. Any subset works; missing providers are skipped and
# the panel says which is off. Keys never reach the browser.
# Both spellings are accepted; PEXELS_API / PIXABAY_API are what this
# deployment actually uses.
PEXELS_API=
PIXABAY_API=
UNSPLASH_ACCESS_KEY=
# Iconify needs no key. Brandfetch reuses BRANDFETCH_API_KEY above.
# Optional: the live Google Fonts catalogue. Without it a curated list is used.
GOOGLE_FONTS_API_KEY=
# Cached search results, so paging and retyping don't burn provider rate limit.
PHOTO_CACHE_SECONDS=900
IMAGE_CREATOR_FOLDER=smart1-image-projects
# Image generation model (needs OPENAI_API_KEY).
OPENAI_IMAGE_MODEL=gpt-image-1

# ================= Background Remover (/tools/bg-remover) =================
# Paid per image. The tool shows the remaining balance before you spend it and
# caches results so a retry never costs a second credit.
REMOVE_BG_API_KEY=
BG_REMOVER_FOLDER=smart1-cutouts

# ================= AI (SEO, blogs, FAQ Builder, proposals) =================
# Powers schema generation, the blog writer, the FAQ Builder, the SEO Image
# Pipeline, and the Google Business Profile lookup that fills in client info.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ================= Commercial Builder (/tools/commercial-builder) =================
# Every provider here degrades to mock mode rather than erroring, so a missing
# or misnamed key does not announce itself: concepts come back from templates,
# stock search returns placeholders, and the finished commercial is a job id
# with no file behind it. The dashboard's "Check keys" button asks each
# provider whether it actually accepts the key, which is the only way to tell
# a working key from a truncated, revoked or out-of-credit one.
#
# Both spellings are accepted for each, exactly as with PEXELS_API above. The
# short form is what this deployment uses.
#
# Uses OPENAI_API_KEY, PEXELS_API, PIXABAY_API and CLOUDINARY_URL from above.
# Spokesperson scenes (HeyGen) — without it a presenter scene has no clip.
HEYGEN_API=
# Real HeyGen avatar ids for the Smart 1 talent roster, as JSON. Until a
# person appears here the picker shows them as not yet available rather than
# offering a tile that fails on click.
#SMART1_TALENT_AVATARS={"sarah":"","mike":""}
# AI video scenes (Runway) — animates a generated still. Clips are 5s or 10s.
RUNWAY_API=
#RUNWAY_API_VERSION=2024-11-06
# Voiceover (ElevenLabs) — without it a commercial renders with no voice track.
ELEVENLABS_API=
#ELEVENLABS_MODEL=eleven_multilingual_v2
# Final render (Creatomate) — the last step. Without it nothing is produced.
CREATOMATE_API=

# ================= Shared =================
AUDIT_LOG_PATH=/var/data/hub-audit.log.jsonl
MAX_UPLOAD_MB=100
FLASK_ENV=production

# ---------------------------------------------------------------------------
# v7 shared services (hub/config.py reads everything through one place)
# ---------------------------------------------------------------------------
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TIMEOUT=90
OPENAI_RETRIES=2
# Both spellings are accepted; PEXELS_API / PIXABAY_API are what this
# deployment actually uses.
PEXELS_API=
PIXABAY_API=
UNSPLASH_ACCESS_KEY=
REMOVE_BG_API_KEY=
GOOGLE_FONTS_API_KEY=
SEO_IMAGES_MAX_EDGE=2400
HUB_PREVIEW_EDGE=640
HUB_AI_USAGE_LOG=true
# Legacy per-module folder vars are still honoured, but the default layout is
# now derived from settings.folder(kind) — you no longer need to set these.
# CLOUDINARY_FOLDER / SEO_IMAGES_FOLDER / IMAGE_CREATOR_FOLDER / BG_REMOVER_FOLDER

# ---------------------------------------------------------------------------
# v7.1 — domain login, demo mode
# ---------------------------------------------------------------------------
# Reuses the GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET already set for Google Finder.
ALLOWED_LOGIN_DOMAINS=smart1marketing.com
HUB_ADMIN_EMAILS=todd@smart1marketing.com
# Optional extra allowlist. Blank = anyone on an allowed domain.
ALLOWED_EMAILS=
# Any non-empty value enables demo sign-in. Share this with the team.
HUB_DEMO_CODE=
# true ONLY on a throwaway training instance — puts EVERYONE in demo mode.
HUB_DEMO_MODE=false

# ---------------------------------------------------------------------------
# v7.5 — provider allowances and warning thresholds (/diagnostics)
# Counts come from the activity log, so changing these needs no redeploy.
# ---------------------------------------------------------------------------
BRANDFETCH_WARN_AT=80
BRANDFETCH_MONTHLY_LIMIT=100
INSITES_WARN_AT=900
INSITES_MONTHLY_LIMIT=1000
REMOVEBG_WARN_AT=40
REMOVEBG_MONTHLY_LIMIT=50

# ---------------------------------------------------------------------------
# Google, ElevenLabs and Cloudinary usage estimates (/diagnostics)
#
# These three are metered in something other than "calls", so each needs its
# own unit rather than a shared allowance:
#
#   ElevenLabs bills per CHARACTER of script. The default below is the
#   Creator plan's 100,000 a month; change it the day you change plan. The
#   price is only used to turn characters into a dollar figure — Flash and
#   Turbo voice models are billed at half a credit per character and the
#   estimate already accounts for that.
#
#   Cloudinary bills in CREDITS, where one credit is 1,000 transformations OR
#   1 GB stored OR 1 GB delivered. Cloudinary's own meter is read live and is
#   the authority; leave CLOUDINARY_USD_PER_CREDIT unset and credits are still
#   reported, just not priced. (Set it and the Hub can show money — a Plus
#   plan works out around 0.40.)
#
#   Google costs nothing. What runs out is a DAILY request quota, so the two
#   published ceilings are set here and the rest are counted without being
#   measured against anything. Set one of the others only to your project's
#   actual grant — an invented ceiling is worse than none.
# ---------------------------------------------------------------------------
ELEVENLABS_WARN_AT=90000
ELEVENLABS_MONTHLY_LIMIT=100000
ELEVENLABS_USD_PER_1K_CREDITS=0.22
#CLOUDINARY_WARN_AT=
#CLOUDINARY_MONTHLY_LIMIT=
#CLOUDINARY_USD_PER_CREDIT=
GOOGLE_ADS_DAILY_QUOTA=15000
GTM_DAILY_QUOTA=10000
#GA4_ADMIN_DAILY_QUOTA=
#GSC_DAILY_QUOTA=
#GBP_DAILY_QUOTA=
#GOOGLE_FONTS_DAILY_QUOTA=

# ---------------------------------------------------------------------------
# v1.10 — user accounts
# todd@, george@ and kaden@ smart1marketing.com are super admins by default
# (named in hub/users.py). This variable only ADDS to that list, so a typo
# here can never lock the founders out.
# ---------------------------------------------------------------------------
HUB_SUPER_ADMINS=
ALLOWED_LOGIN_DOMAINS=smart1marketing.com

# ---------------------------------------------------------------------------
# The staff roster and its starting password
# ---------------------------------------------------------------------------
# Everyone on the company census has an account, created on boot from the list
# in hub/user_directory.py. Each one starts on the password below and is made
# to replace it at their first sign-in — the Hub will not serve any page,
# mounted module included, until they do.
#
# It is deliberately NOT a secret and it is fine to leave this blank: the
# default (Smart12026!) is in the repository, and what makes that safe is that
# it is valid for exactly one sign-in per person. Set it only if you would
# rather the starting password were not written down.
#
# A re-deploy never re-applies it. sync_roster() creates accounts that are
# missing and touches nothing else, so nobody's chosen password is reset and
# nobody's promotion is taken back.
HUB_DEFAULT_PASSWORD=

# Two levels of access, and they are the role rather than a separate setting:
# Admin (role admin or super_admin) sees everything; General (role member) sees
# everything except Utilities — Diagnostics, System Status, Users and the
# Activity Log. hub/access.py holds the path list. Change somebody's level on
# the Users panel at /diagnostics/users; there is no environment variable for
# it, because a level that could be set in two places is a level that
# disagrees with itself.

# Show the "Sign in with Google" button. Off by default — the OAuth consent
# screen for the sensitive scopes is still in Google review, so the button
# would offer a route that cannot work yet. Set true once approved.
HUB_GOOGLE_LOGIN=false

# Inbound Smart 1 Suite (GoHighLevel) webhook. Point a GHL workflow at
# {PUBLIC_BASE_URL}/api/hooks/ghl?token=... on opportunity created/updated/
# stage-changed. The endpoint rejects everything without this — it fails closed.
GHL_WEBHOOK_TOKEN=

# Push a client's brand guide (colours, fonts, logo URLs) into Smart 1 Suite.
# Point at a GoHighLevel inbound webhook. Without it the payload is still
# returned in the API response, ready to paste.
GHL_BRAND_WEBHOOK_URL=
# Password-reset delivery via a Suite workflow (the Hub has no mail sender).
GHL_RESET_WEBHOOK_URL=

# Publishing generated content to Smart 1 Suite as a blog post.
# The sub-account that owns the blog (e.g. the Smart 1 Marketing location).
GHL_BLOG_LOCATION_ID=
# The Private Integration Token needs these scopes:
#   blogs/list.readonly  blogs/author.readonly  blogs/category.readonly
#   blogs/check-slug.readonly  blogs/post.write  blogs/post-update.write

# Background jobs. On automatically on Render; off elsewhere so a local test
# run can't fire real jobs at client systems. Exactly one worker runs them.
HUB_SCHEDULER=true
# How long a scan may run before it's stopped automatically (minutes).
SCANS_STUCK_MINUTES=30

# SmartForecast Dynamic Website. WEATHERAPI_KEY enables live observations;
# simulator and manual override remain available without it. Render uses the
# persistent-disk path below. Leave SMARTFORECAST_DB_PATH blank locally to use
# modules/smartforecast/data/smartforecast.sqlite3.
WEATHERAPI_KEY=
SMARTFORECAST_DB_PATH=
SMARTFORECAST_WEATHER_RETENTION_DAYS=120
SMARTFORECAST_ENGAGEMENT_RETENTION_DAYS=400

# Live IO products from Knack object_135. Without these the Hub can use only
# the optional private fallback configured below.
KNACK_PRODUCTS_TTL_MINUTES=180

# Optional private fallback for the Clients screen when Knack is unavailable.
# Point this at a private mounted volume outside the source checkout. Never
# commit the real products.json or websites.json exports.
CLIENTS_DATA_DIR=/var/data/smarthub-clients

# The Ad Copy Request object. Leave this unset and the Hub discovers it —
# whichever object carries field_1804 (Seller Name) is the one — which costs
# one /objects call, or a bounded walk on a plan that does not publish fields
# inline. Set it to skip the discovery, or when the walk gives up and says so
# on the form. The field ids themselves are pinned in hub/ad_copy.py and each
# is overridable as KNACK_AD_COPY_<KEY>, e.g. KNACK_AD_COPY_CAMPAIGN.
# KNACK_AD_COPY_OBJECT=object_144
KNACK_AD_COPY_SCAN_LIMIT=60

# Google Tag Manager pacing. Tag Manager's per-user rate limit is much lower
# than Analytics', and with 150+ GTM accounts on one login an unpaced sweep
# gets 429 on nearly every container request. Raise the interval if 429s
# persist in the deploy log.
GTM_MIN_INTERVAL_SECONDS=0.35
GTM_MAX_RETRIES=4

# Google Business Profile lookups. Off until Google grants project access to
# the Business Profile APIs — until then every call 403s once per connected
# account and floods the deploy log.
GOOGLE_GMB_ENABLED=false

# IO Builder — ported into the Hub at /tools/io/ (was an iframe to
# insertionordersmart.onrender.com). Submissions post to this webhook.
GHL_WEBHOOK_URL=
# Override only if you need to point Sales Builder back at the standalone app.
IO_APP_URL=/tools/io/

# ---- Lead delivery into Smart 1 Suite ------------------------------------
#
# Landing pages and calculators post to /api/leads/capture, which stores the
# lead first and then delivers it. There is ONE route: the Suite Contacts API.
# It returns a contact id, which is the only real proof the lead arrived.
#
# The Smart 1 Marketing SUB-ACCOUNT id. This is a location id and it is NOT
# GHL_COMPANY_ID — they are different id spaces, and a company id used here
# addresses the agency instead, silently. The Hub refuses the value outright
# if it matches the company id. Find it in Suite under Settings → Business
# Profile, or call /api/leads/ghl/preflight?find=1 to look it up by name.
# The token needs the contacts.write scope.
GHL_LEAD_LOCATION_ID=

# RETIRED — do not set. The Hub used to POST leads to an inbound Suite webhook
# when the API route was unconfigured. Nothing posts to it now, and setting it
# is not a fallback: with GHL_LEAD_LOCATION_ID unset, leads are stored and
# queued rather than delivered.
#
# If a value is still set on Render, the leads panel says so. Clearing it is
# only half the job — the webhook TRIGGER in the Suite workflow has to be
# switched off too, because a workflow still firing on that URL creates a
# second contact for any lead that reaches it.
# HUB_LEAD_WEBHOOK_URL=

# Public lead capture (/api/leads/capture) is unauthenticated by design —
# landing pages post to it. This caps submissions per visitor IP per hour so
# a script cannot bury the real leads. 0 turns the limit off.
LEADS_RATE_LIMIT=3
LEADS_RATE_WINDOW_SECONDS=3600

# Public landing pages (/land/boat, /land/hvac, /land/legal, /land/ski).
# These have no Hub login and /api/analyze spends OpenAI credit per call, so
# each visitor address gets a ceiling per hour. 0 disables.
LANDING_ANALYZE_LIMIT=6
LANDING_PARTIAL_LIMIT=30

# ---- Public scan widget (embeddable AI-visibility checker) ----
# Leads it captures go to the shared store and out over the Suite API, like
# every other capture point — the widget has no delivery route of its own.
# A domain already audited within this many days reuses that audit instead of
# spending another Insites credit. Default 30.
SCANS_WIDGET_REUSE_DAYS=30
# Free pre-checks allowed per IP per 10 minutes. 0 turns the limit off.
SCANS_WIDGET_PRECHECK_LIMIT=12

# ---- Social content requests and ideas (/tools/social) ----
# All four have working defaults; none of them is required. They are read at
# call time rather than at import, so adding one on Render takes effect on the
# next request rather than on the next deploy.
# How many ideas a client is offered to swipe on in one batch. Five is a
# glance, twenty is a form, and a batch nobody finishes teaches people to
# ignore the next one. Default 6.
SOCIAL_SUGGESTION_BATCH_SIZE=6
# The share of each batch spent on kinds of post this client has never
# answered on. Without it the mix converges on whatever they liked first and
# the tool stops being able to learn anything new. 80/20 is a reasonable
# default, not a measured one. Default 0.2.
SOCIAL_TAG_EXPLORE_RATIO=0.2
# How near two requested dates have to be, in days, before two locations'
# requests are flagged as a possible duplicate. Advisory only: nothing is ever
# auto-merged or auto-declined on it. Default 2.
SOCIAL_REQUEST_DUPLICATE_WINDOW_DAYS=2
# The Social Planner collection path on Smart 1 Suite's API. Transcribed from
# the build spec and never yet exercised against the live API, because
# `social-media-posting.write` has not been consented — so a corrected path is
# one variable rather than a deploy. Everything works through the CSV export
# meanwhile. Default /social-planner/posts.
# SOCIAL_SUITE_POST_PATH=/social-planner/posts

# ---- Smart 1 Suite app frame (/suite-app) ----
# A page framed inside a CLIENT's own Suite sub-account. They have no Hub
# account, so identity comes from HighLevel's SSO handshake rather than from a
# cookie. This key is issued on the marketplace app's own settings page and is
# a THIRD credential, separate from GHL_CLIENT_ID and GHL_CLIENT_SECRET.
# Unset, the frame says so in words and grants nothing — it never falls back
# to trusting the frame.
# GHL_SSO_KEY=

# ---- Master Services Agreement (/msa) ----
# The signing page is public: a client signing an agreement has no Hub login.
# Signing costs a PDF render, a Cloudinary upload and a lead write, so each
# visitor address gets a ceiling per hour. 0 turns the limit off.
MSA_SIGN_LIMIT=6
# Who may put /msa/embed in an iframe, in CSP frame-ancestors syntax
# (space-separated). An ALLOWLIST on purpose: the scans widget above sends
# "*" because it is pasted onto clients' own domains and cannot know them in
# advance, whereas this page is only ever framed on ours and it takes a
# legally binding signature — a page anyone can frame is a page anyone can
# lay a transparent button over. Add a domain here rather than in code.
MSA_FRAME_ANCESTORS='self' https://smart1marketing.com https://*.smart1marketing.com
