# ================= Smart 1 Hub =================
# One login for every module.
PANEL_PASSWORD=change-me-to-something-strong
# Signs the hub login cookie AND the Sites admin session. Keep it stable so
# logins survive restarts. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# ================= Suite (GoHighLevel) =================
GHL_PRIVATE_TOKEN=pit-...
GHL_COMPANY_ID=
GHL_API_VERSION=2021-07-28
# Optional — enables "Auto-fill from client website"
BRANDFETCH_API_KEY=

# ================= Sites (Simvoly) =================
SIMVOLY_API_KEY=
SIMVOLY_API_BASE_URL=https://api.smart1sites.com
# Render Postgres Internal Database URL
DATABASE_URL=
MOCK_MODE=false
ENABLE_WRITE_ACTIONS=false

# ================= Google Finder =================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FLASK_SECRET_KEY=
ALLOWED_EMAILS=adops@smart1marketing.com,smartadops@gmail.com,smart1sites@gmail.com
CACHE_SECONDS=900
TOKEN_DB_PATH=/var/data/google_tokens.db
# Generate once, never change: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ================= Shared =================
AUDIT_LOG_PATH=/var/data/hub-audit.log.jsonl
MAX_UPLOAD_MB=100
FLASK_ENV=production
